{
  "name": "whydiff",
  "version": "0.2.0",
  "description": "WHYDIFF CLI - Behavioral Change Detection and Verification",
  "type": "module",
  "bin": {
    "whydiff": "./dist/bin/whydiff.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@whydiff/core": "workspace:*",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
